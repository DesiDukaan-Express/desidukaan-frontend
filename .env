# API endpoints
# localhost works only when running Expo dev server + backend on same machine.
# For Android emulator, use 10.0.2.2 (Android's alias for host localhost).
# For physical device / production, use the deployed backend URL.

#EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_API_URL=http://10.38.183.219:3000/api

#EXPO_PUBLIC_SOCKET_URL=http://localhost:3000
EXPO_PUBLIC_SOCKET_URL=http://10.38.183.219:3000

# Environment: "testing" | "production"
# testing  → OTP step is skipped; sign-up/sign-in complete without SMS
# production → OTP step is shown and required (Twilio must be configured on backend)
EXPO_PUBLIC_ENV=testing
